# Privy — https://dashboard.privy.io
NEXT_PUBLIC_PRIVY_APP_ID=your-privy-app-id
# Server-only. Never prefix with NEXT_PUBLIC_.
PRIVY_APP_SECRET=your-privy-app-secret
# Optional; defaults to https://auth.privy.io/api/v1/apps/<app id>/jwks.json
PRIVY_JWKS_URL=

# Optional: dedicated RPCs for quotes, balances and the embedded wallet.
# Default to https://ethereum-rpc.publicnode.com and
# https://ethereum-sepolia-rpc.publicnode.com.
NEXT_PUBLIC_RPC_URL=
NEXT_PUBLIC_SEPOLIA_RPC_URL=
